{
  "name": "summary",
  "description": "Generate a natural language description of an image",
  "version": "1.0.0",
  "inputs": {
    "required": ["image"],
    "optional": ["focus"]
  },
  "outputs": ["description"],
  "supportedProviders": ["smolvlm"],
  "defaultTimeout": 30000,
  "defaultRetry": { "max": 1, "strategy": "reprompt" }
}
