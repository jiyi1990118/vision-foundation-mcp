{
  "name": "table",
  "description": "Reconstruct table structure from an image: row/column counts, headers, and cell data row by row",
  "version": "1.0.0",
  "inputs": { "required": ["image"], "optional": [] },
  "outputs": ["description", "rowCount", "columnCount"],
  "supportedProviders": ["gguf-smolvlm", "gguf-smolvlm2", "minicpm-v"],
  "defaultTimeout": 30000,
  "defaultRetry": { "max": 1, "strategy": "reprompt" }
}
