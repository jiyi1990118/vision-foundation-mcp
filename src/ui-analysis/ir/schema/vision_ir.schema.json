{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vision-foundation-mcp/vision_ir.schema.json",
  "title": "VisionIR",
  "description": "Raw detection facts (boxes, OCR, masks, color samples) before inference. Layer 1 of the UI analysis IR.",
  "type": "object",
  "required": ["detections", "ocr"],
  "additionalProperties": false,
  "properties": {
    "detections": {
      "type": "array",
      "description": "Detected visual elements as typed bounding boxes with a confidence score.",
      "items": {
        "type": "object",
        "required": ["type", "bbox", "score"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "description": "Detector-specific type label, e.g. button, card, icon." },
          "bbox": { "$ref": "#/$defs/bbox" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "text": { "type": "string" },
          "state": { "type": "string", "enum": ["default", "active", "selected", "disabled"] },
          "variant": { "type": "string", "enum": ["primary", "secondary", "success", "danger", "ghost", "default"] }
        }
      }
    },
    "ocr": {
      "type": "array",
      "description": "OCR text boxes with recognition confidence.",
      "items": {
        "type": "object",
        "required": ["text", "bbox", "confidence"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "bbox": { "$ref": "#/$defs/bbox" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "masks": {
      "type": "array",
      "description": "Optional segmentation masks summarized as bounding boxes and pixel area.",
      "items": {
        "type": "object",
        "required": ["id", "bbox", "area"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "bbox": { "$ref": "#/$defs/bbox" },
          "area": { "type": "number", "minimum": 0 }
        }
      }
    },
    "colorSamples": {
      "type": "array",
      "description": "Optional sampled colors with semantic role and frequency.",
      "items": {
        "type": "object",
        "required": ["hex", "role", "frequency"],
        "additionalProperties": false,
        "properties": {
          "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "role": { "type": "string" },
          "frequency": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "description": "Axis-aligned bounding box in pixel coordinates.",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 }
      }
    }
  }
}
