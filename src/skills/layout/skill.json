{
  "name": "layout",
  "description": "Analyze the visual layout structure of an image (grid/columns/rows/sidebar/sections)",
  "version": "1.0.0",
  "inputs": { "required": ["image"], "optional": [] },
  "outputs": ["description", "layoutType"],
  "supportedProviders": ["gguf-smolvlm", "gguf-smolvlm2", "minicpm-v"],
  "defaultTimeout": 30000,
  "defaultRetry": { "max": 1, "strategy": "reprompt" }
}
