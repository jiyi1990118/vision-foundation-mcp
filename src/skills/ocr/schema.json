{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["texts"],
  "additionalProperties": false,
  "properties": {
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "position": {
            "type": "string",
            "description": "Either a coarse region such as center/top-left or a coordinate box string x1,y1,x2,y2 from a dedicated OCR provider."
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "language": { "type": "string" }
  }
}
