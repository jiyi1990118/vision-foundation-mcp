{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vision-foundation-mcp/semantic_ast.schema.json",
  "title": "SemanticAST",
  "description": "Hierarchical component tree built from LayoutIR. Layer 3 of the UI analysis IR.",
  "type": "object",
  "required": ["root", "version"],
  "additionalProperties": false,
  "properties": {
    "root": { "$ref": "#/$defs/astNode" },
    "version": { "type": "string", "description": "AST schema version, e.g. 1.0.0." }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 }
      }
    },
    "componentType": {
      "type": "string",
      "enum": [
        "page", "container", "header", "footer", "navbar", "sidebar", "toolbar",
        "card", "section", "list", "listItem", "table", "row", "column", "grid",
        "button", "iconButton", "text", "title", "subtitle", "input", "textarea",
        "checkbox", "radio", "switch", "select", "dropdown", "image", "avatar",
        "icon", "divider", "progress", "badge", "tag", "tab", "dialog", "drawer",
        "bottomSheet", "unknown"
      ]
    },
    "astNode": {
      "type": "object",
      "required": ["id", "type", "bbox", "props", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/componentType" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "props": { "type": "object", "description": "Free-form component properties." },
        "text": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/astNode" }
        }
      }
    }
  }
}
