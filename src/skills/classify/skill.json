{
  "name": "classify",
  "description": "Identify the overall category of an image",
  "version": "1.1.0",
  "inputs": {
    "required": ["image"],
    "optional": ["focus"]
  },
  "outputs": ["category", "confidence", "reasoning"],
  "supportedProviders": ["smolvlm", "gguf", "minicpm"],
  "defaultTimeout": 30000,
  "defaultRetry": { "max": 1, "strategy": "reprompt" }
}